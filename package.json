{
  "name": "pro-finder-accessibility-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "THITRONIK Pro-finder – barrierefreie Setup-Karte und digitale Anleitung (interner Pilot)",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:check": "node scripts/check-content.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "card:check": "node design/card/check-card-svg.mjs",
    "reference:check": "node scripts/check-reference-clean.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "progress": "node scripts/progress.mjs",
    "progress:check": "node scripts/progress.mjs --check",
    "supabase:reset": "supabase db reset --local",
    "supabase:test": "supabase test db --local",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run content:check && npm run tokens:check && npm run card:check && npm run reference:check && npm run secrets:check && npm run progress:check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.6",
    "supabase": "2.111.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
